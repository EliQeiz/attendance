rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStudent() {
      return hasProfile() && profile().role == 'student';
    }

    function isLecturer() {
      return hasProfile() && profile().role == 'lecturer';
    }

    function isCourseOwner(courseId) {
      return isLecturer()
        && exists(/databases/$(database)/documents/courses/$(courseId))
        && get(/databases/$(database)/documents/courses/$(courseId)).data.lecturerId == request.auth.uid;
    }

    function sessionExists(sessionId) {
      return exists(/databases/$(database)/documents/attendance/$(sessionId));
    }

    function session(sessionId) {
      return get(/databases/$(database)/documents/attendance/$(sessionId)).data;
    }

    function isSessionLecturer(sessionId) {
      return isLecturer()
        && sessionExists(sessionId)
        && session(sessionId).lecturerId == request.auth.uid;
    }

    function validProfileCreate(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'name',
          'knust_id',
          'login_id',
          'role',
          'email',
          'authEmail',
          'recoveryEmail',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.knust_id is string
        && request.resource.data.login_id is string
        && request.resource.data.recoveryEmail is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.authEmail == request.auth.token.email
        && request.resource.data.recoveryEmail == request.auth.token.email
        && request.resource.data.role in ['student', 'lecturer'];
    }

    match /lecturerApprovals/{lecturerId} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow create: if validProfileCreate(uid)
        && (
          (
            request.resource.data.role == 'student'
            && request.resource.data.knust_id.matches('^[0-9]{8}$')
          )
          || (
            request.resource.data.role == 'lecturer'
            && exists(/databases/$(database)/documents/lecturerApprovals/$(request.resource.data.login_id))
          )
        );

      allow get: if signedIn() && (request.auth.uid == uid || isLecturer());
      allow list: if isLecturer();

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.knust_id == resource.data.knust_id
        && request.resource.data.login_id == resource.data.login_id;

      allow delete: if false;
    }

    match /studentAccounts/{studentId} {
      allow create: if signedIn()
        && studentId.matches('^[0-9]{8}$')
        && request.resource.data.keys().hasOnly([
          'uid',
          'knust_id',
          'recoveryEmail',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.knust_id == studentId
        && request.resource.data.recoveryEmail == request.auth.token.email
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.knust_id == studentId;
      allow read, update, delete: if false;
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow create: if isLecturer()
        && request.resource.data.lecturerId == request.auth.uid;
      allow update, delete: if isLecturer()
        && resource.data.lecturerId == request.auth.uid;

      match /students/{studentId} {
        allow get: if isCourseOwner(courseId)
          || (isStudent() && profile().knust_id == studentId);
        allow list: if isCourseOwner(courseId);
        allow create, update, delete: if isCourseOwner(courseId);
      }
    }

    match /attendance/{sessionId} {
      allow get, list: if (isSessionLecturer(sessionId))
        || (isStudent() && resource.data.active == true);

      allow create: if isLecturer()
        && request.resource.data.lecturerId == request.auth.uid
        && request.resource.data.courseId is string
        && isCourseOwner(request.resource.data.courseId);

      allow update: if isSessionLecturer(sessionId);
      allow delete: if false;

      // The projected QR session code and lecturer GPS coordinate live here so
      // students can never read or forge them. Only the session lecturer (and
      // the admin Cloud Function, which bypasses rules) can touch this document.
      match /secure/{docId} {
        allow read, write: if isSessionLecturer(sessionId);
      }

      match /records/{studentId} {
        allow get: if isSessionLecturer(sessionId)
          || (isStudent() && profile().knust_id == studentId);
        allow list: if isSessionLecturer(sessionId);

        // Student self-verification is handled exclusively by the
        // submitAttendance Cloud Function (admin SDK), which validates the QR
        // session code, GPS proximity, roster membership, and device uniqueness
        // server-side. Students cannot write records directly. Lecturers retain
        // manual create/update for corrections and scan-only approvals.
        allow create: if isSessionLecturer(sessionId);
        allow update, delete: if isSessionLecturer(sessionId);
      }

      match /devices/{deviceId} {
        allow get, list: if isSessionLecturer(sessionId);

        // Device fingerprints are written by the Cloud Function (admin SDK).
        allow create, update, delete: if isSessionLecturer(sessionId);
      }

      match /audit/{auditId} {
        allow read, create: if isSessionLecturer(sessionId);
        allow update, delete: if false;
      }
    }
  }
}
